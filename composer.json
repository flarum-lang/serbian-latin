{
	"name": "flarum-lang/serbian-latin",
	"description": "Serbian (Latin) Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/serbian-latin",
	"license": "MIT",
	"support": {
		"issues": "https://github.com/flarum-lang/serbian-latin/issues",
		"forum": "https://discuss.flarum.org/d/40214",
		"source": "https://github.com/flarum-lang/serbian-latin"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "Serbian (Latin)",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "sr-Latn",
			"title": "Srpski (latinica)"
		}
	}
}
